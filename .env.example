# Relay needs no environment variables to run locally.

# Production only: the SSRF guard blocks localhost URLs when NODE_ENV=production.
# The built-in demo destination is served by Relay itself at localhost, so set
# this to 1 on a deployed demo. Leave it unset if you only deliver to real
# external endpoints.
ALLOW_LOCAL_ENDPOINTS=1

# Set by most hosts automatically. Also used to build the demo destination URL.
# PORT=3000
